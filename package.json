{
  "name": "thingcost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "dotenv -e .env -- pnpm --parallel --stream --filter @thingcost/web --filter @thingcost/api --filter @thingcost/worker dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm tokens:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "tokens:check": "tsx scripts/check-theme-tokens.ts",
    "db:generate": "dotenv -e .env -- pnpm --filter @thingcost/database db:generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @thingcost/database db:migrate",
    "db:studio": "dotenv -e .env -- pnpm --filter @thingcost/database db:studio"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.1.2",
    "dotenv-cli": "11.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "tsx": "4.23.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
