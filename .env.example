# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
APP_TIME_ZONE=Asia/Shanghai
APP_BASE_CURRENCY=CNY
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v2
# Local development storage; Docker Compose overrides this with /data/attachments.
ATTACHMENTS_DIR=./.data/attachments
ATTACHMENT_MAX_BYTES=20971520
ATTACHMENT_MAX_COUNT_PER_ASSET=50
# Set to the externally visible origin when enforcing Origin checks behind a proxy.
# APP_ORIGIN=https://chronicle.example.com
# COOKIE_SECURE=true

# Docker Compose deployment
POSTGRES_PASSWORD=replace-with-a-long-random-password
CHRONICLE_PORT=3000

# PostgreSQL for local development
DATABASE_URL=postgres://chronicle:replace-with-a-long-random-password@localhost:5432/chronicle

# Browser development server
VITE_API_BASE_URL=http://localhost:3000

# Required before storing provider secrets in the database.
# Generate a random 32-byte value and encode it as base64.
APP_MASTER_KEY=

# Optional environment-managed notification channels. Environment secrets override UI storage.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REMINDER_WEBHOOK_URL=
REMINDER_WEBHOOK_SECRET=

# Optional AI valuation providers. Core ledger works without these.
# TAVILY_API_KEY=
# TAVILY_BASE_URL=https://api.tavily.com
# AI_BASE_URL=https://api.deepseek.com
# AI_API_KEY=
# AI_MODEL=deepseek-chat
# AI_PROTOCOL=chat_completions
# AI_TIMEOUT_MS=45000
# AI_PROVIDER_NAME=deepseek
# AI_MONTHLY_BUDGET=50
# AI_CONCURRENCY=1
# AI_SEARCH_CACHE_TTL_MS=86400000
# VALUATION_CLAIM_LIMIT=5

# Reminder Worker tuning
REMINDER_POLL_INTERVAL_MS=10000
REMINDER_EXPANSION_DAYS=400
REMINDER_DELIVERY_MAX_ATTEMPTS=4
REMINDER_CLAIM_LIMIT=20
